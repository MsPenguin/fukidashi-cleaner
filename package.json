{
  "name": "fukidashi-cleaner",
  "version": "0.0.1",
  "description": "Electron desktop app for removing speech-bubble text from images with a local ONNX pipeline.",
  "private": true,
  "packageManager": "yarn@4.15.0",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "yarn build && electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist:dir": "yarn build && node scripts/run-electron-builder.js --dir",
    "dist": "yarn build && node scripts/run-electron-builder.js",
    "dist:win": "yarn build && node scripts/run-electron-builder.js --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "onnxruntime-node": "^1.26.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.3"
  }
}
